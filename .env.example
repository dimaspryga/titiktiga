# ==============================================================================
# TITIKTIGA STUDIO - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Salin file ini menjadi .env.local untuk konfigurasi lokal atau pasang di Vercel
# ==============================================================================

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://ipyfobhccfdgrfioscji.supabase.co
SUPABASE_URL=https://ipyfobhccfdgrfioscji.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Security & Authentication Token Secret
JWT_SECRET=your_jwt_secret_512bit_string
# Demo account credentials are blocked in production unless explicitly enabled.
ENABLE_DEMO_ACCOUNTS=false

# Application Domain & Host
APP_URL=https://your-production-domain.com

# SMTP Mail Notification Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM="Titiktiga <noreply@titiktiga.studio>"

# Midtrans Payment Gateway (Snap API)
# Dapatkan dari https://dashboard.midtrans.com/ (Settings > Access Keys)
# Ganti MIDTRANS_IS_PRODUCTION=true saat live ke nasabah
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
